# ============================================================
# Sistema TalitaCumi - variables del stack Docker
# Copiar a .env y ajustar los valores para el entorno local.
# No incluir secretos reales en este archivo.
# ============================================================

COMPOSE_PROJECT_NAME=sistema-talitacumi

# Puertos publicados en el host
APP_PORT=8090
POSTGRES_PORT=5434

# UID/GID del usuario Linux dueño del proyecto (id -u / id -g)
UID=1000
GID=1000

# Aplicación
APP_NAME=TalitaCumi
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090
FRONTEND_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:4200
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/La_Paz
APP_CURRENCY=BOB
APP_CURRENCY_SYMBOL=Bs

# Base de datos (host: localhost:5434 / red Docker: db:5432)
POSTGRES_DB=talitacumi
POSTGRES_USER=talitacumi
POSTGRES_PASSWORD=talitacumi_dev_password

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=talitacumi
DB_USERNAME=talitacumi
DB_PASSWORD=talitacumi_dev_password

# Sesiones y colas sin servicios externos (skeleton)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Sanctum (autenticación por token)
SANCTUM_STATEFUL_DOMAINS=localhost:8090,localhost:4200,127.0.0.1:8090
