APP_NAME=TalitaCumi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz
APP_CURRENCY=BOB
APP_CURRENCY_SYMBOL=Bs

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=talitacumi
DB_USERNAME=talitacumi
DB_PASSWORD=talitacumi_dev_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@talitacumi.local"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:8090,localhost:4200,127.0.0.1:8090

VITE_APP_NAME="${APP_NAME}"

# Módulo 02 — bootstrap del primer Superadmin.
# No completar con contraseñas reales en el repositorio.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_DOCUMENTO=
SUPERADMIN_PASSWORD=

# Módulo 02 — usuarios demo (solo desarrollo).
# El seeder SeguridadDemoUsersSeeder se bloquea en producción.
# Password12 cumple la política inicial: 10 caracteres, mayúscula, minúscula y número.
DEMO_PASSWORD=Password12
DEMO_FORCE_PASSWORD_CHANGE=false
# Opcionales: permiten cambiar identificadores sin tocar el seeder.
# DEMO_SUPERADMIN_EMAIL=
# DEMO_SUPERADMIN_USERNAME=
# DEMO_SUPERADMIN_DOCUMENTO=
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_USERNAME=
# DEMO_ADMIN_DOCUMENTO=
# DEMO_RECEPCION_EMAIL=
# DEMO_RECEPCION_USERNAME=
# DEMO_RECEPCION_DOCUMENTO=

# Producción detrás de TLS / proxy inverso.
FORCE_HTTPS=false
# TRUSTED_PROXIES=
